# Copy this file to .env and fill in real values. .env is gitignored — never
# commit actual secrets.

# Required once the server is reachable from outside your LAN (e.g. behind
# the cloudflared tunnel). Generate one with: openssl rand -hex 32
SYNC_API_KEY=

# Only needed if you're running the optional cloudflared service. Get this
# from the Cloudflare Zero Trust dashboard → Networks → Tunnels → your
# tunnel → "Install and run a connector".
CLOUDFLARE_TUNNEL_TOKEN=

# Copy this file to .env and fill in real values. .env is gitignored: never
# commit actual secrets.

# Required when the server is reachable through a tunnel, a proxy or the
# internet (without it, such requests get 401). Generate one with:
#   markdown-preview-sync genkey
#   docker run --rm ghcr.io/henriquefps/markdown-preview-sync genkey
# Use the same value in the app: Settings -> Device sync -> API key.
SYNC_API_KEY=

# Optional CORS allow-list, comma separated (e.g. https://markdown.hfps.dev).
# Empty means any origin, which is fine because the API key is what protects
# the data.
ALLOWED_ORIGINS=

# Only for the optional cloudflared service. From the Cloudflare Zero Trust
# dashboard: Networks -> Tunnels -> your tunnel -> "Install and run a connector".
CLOUDFLARE_TUNNEL_TOKEN=
